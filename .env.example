# ===========================================================================
# ARC Transformation Group — environment
#
# Copy to .env.local for development. Nothing here is required to run the
# site: every integration degrades to a working, clearly-labelled "not
# configured" state rather than crashing.
# ===========================================================================

# --- Contact form (existing) ----------------------------------------------
# Without these, /api/contact still succeeds and logs the payload locally.
RESEND_API_KEY=
CONTACT_TO_EMAIL=aking@arctransformationgroup.com
CONTACT_FROM_EMAIL="ARC Website <onboarding@resend.dev>"


# ===========================================================================
# ARC AI Product Playbook — commerce
#
# See playbook/README.md for the manual setup this expects (Paddle product,
# Supabase table, private bucket). Until these are set, /playbook renders in
# full and the checkout button says so instead of breaking.
# ===========================================================================

# --- Paddle Billing -------------------------------------------------------
# "sandbox" or "production". Defaults to sandbox when unset: charging real
# money has to be an explicit act of configuration.
PADDLE_ENVIRONMENT=sandbox

# Server-side API key. Used to confirm transactions on the success page.
# Never exposed to the browser.
PADDLE_API_KEY=

# Client-side token. Paddle publishes this as a public value and it is
# required for the checkout overlay, which is why it carries NEXT_PUBLIC_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Notification destination secret, from Paddle > Developer tools >
# Notifications. Without it the webhook refuses every delivery.
PADDLE_WEBHOOK_SECRET=

# The price ID for the Playbook, from the Paddle catalog. There is no default
# and no fallback — a wrong price ID either fails loudly or charges the wrong
# amount, and both are worse than refusing to run.
PLAYBOOK_PADDLE_PRICE_ID=


# --- Supabase: purchases and the private bundle ----------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key. Bypasses row-level security, so it is server-only and must
# never be given the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=


# --- Storage: where the bundle objects live --------------------------------
# The bucket must be PRIVATE. Downloads are served as short-lived signed URLs
# minted on the server after the entitlement is checked.
PLAYBOOK_STORAGE_BUCKET=

# Object paths inside that bucket. Upload the two artefacts produced by
# `npm run playbook:build` to these keys.
PLAYBOOK_PDF_OBJECT=
PLAYBOOK_ZIP_OBJECT=

# Signed URL lifetime in seconds. Optional; defaults to 300, capped at 3600.
PLAYBOOK_SIGNED_URL_TTL=300


# --- Purchase email --------------------------------------------------------
# Reuses RESEND_API_KEY above. Without a verified sending domain, Resend will
# only deliver to your own address.
PLAYBOOK_FROM_EMAIL="ARC Transformation Group <playbook@arctransformationgroup.com>"
PLAYBOOK_REPLY_TO_EMAIL=aking@arctransformationgroup.com


# --- Canonical URL ---------------------------------------------------------
# Used server-side to build the download link in the purchase email. On Vercel
# this falls back to VERCEL_URL, which is right for previews and wrong for
# production — set it explicitly there.
NEXT_PUBLIC_SITE_URL=https://arctransformationgroup.com
